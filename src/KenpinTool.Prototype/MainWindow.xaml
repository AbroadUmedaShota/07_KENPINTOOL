<Window x:Class="KenpinTool.Prototype.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KenpinTool.Prototype"
        mc:Ignorable="d"
        Title="自動検品ツール (Prototype)"
        Height="900"
        Width="1400"
        MinHeight="720"
        MinWidth="1200"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:BoolToGridLengthConverter x:Key="BoolToGridLength" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="J" Command="{Binding NextPageCommand}" />
        <KeyBinding Key="Right" Command="{Binding NextPageCommand}" />
        <KeyBinding Key="K" Command="{Binding PrevPageCommand}" />
        <KeyBinding Key="Left" Command="{Binding PrevPageCommand}" />
        <KeyBinding Key="N" Command="{Binding NextIssuePageCommand}" />
        <KeyBinding Key="Space" Command="{Binding MarkOkCommand}" />
        <KeyBinding Key="S" Command="{Binding MarkRescanCommand}" />
        <KeyBinding Key="E" Command="{Binding RequestExceptionCommand}" />
        <KeyBinding Key="C" Command="{Binding ToggleCompareCommand}" />
        <KeyBinding Key="F" Command="{Binding ToggleFilterCommand}" />
        <KeyBinding Key="Z" Command="{Binding ToggleZoomCommand}" />
    </Window.InputBindings>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#1E1E1E" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="自動検品ツール (Prototype)"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,16,0">
                    <TextBox Width="640"
                             VerticalContentAlignment="Center"
                             Text="{Binding InputFolderPath, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="Load"
                            Margin="8,0,0,0"
                            Padding="14,6"
                            Command="{Binding LoadCommand}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CaseName}" Foreground="White" Margin="0,0,14,0" />
                    <TextBlock Text="{Binding ProgressText}" Foreground="White" />
                </StackPanel>
            </Grid>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <TextBlock Text="Shortcuts: J/→ Next  K/← Prev  N Next NG  Space OK  S Rescan  E Except  C Compare  F Filter  Z Zoom" />
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="360" />
            </Grid.ColumnDefinitions>

            <!-- Left: Navigation -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListView Grid.Row="0"
                          Margin="10"
                          ItemsSource="{Binding PagesView}"
                          SelectedItem="{Binding SelectedPage}"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2" SnapsToDevicePixels="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Index}" VerticalAlignment="Center" />
                                <Border Grid.Column="1"
                                        Width="44"
                                        Height="20"
                                        CornerRadius="4"
                                        Background="{Binding BadgeBrush}"
                                        Margin="6,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding BadgeText}"
                                               Foreground="White"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding SummaryText}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <DockPanel Grid.Row="1" Margin="10,0,10,10">
                    <CheckBox Content="NG/疑いのみ" IsChecked="{Binding ShowNgOnly}" VerticalAlignment="Center" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding PageCountText}" VerticalAlignment="Center" />
                </DockPanel>
            </Grid>

            <!-- Center: Viewer -->
            <Grid Grid.Column="1" Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding CompareMode, Converter={StaticResource BoolToGridLength}}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Previous page (compare mode) -->
                    <Border Grid.Column="0"
                            Margin="0,0,6,0"
                            BorderBrush="#D0D0D0"
                            BorderThickness="1"
                            CornerRadius="4"
                            Visibility="{Binding CompareMode, Converter={StaticResource BoolToVisibility}}">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Grid LayoutTransform="{Binding ZoomTransform}">
                                <Image Source="{Binding PreviousImage}"
                                       Stretch="None"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top" />
                            </Grid>
                        </ScrollViewer>
                    </Border>

                    <!-- Current page -->
                    <Border Grid.Column="1"
                            BorderBrush="#D0D0D0"
                            BorderThickness="1"
                            CornerRadius="4">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Grid LayoutTransform="{Binding ZoomTransform}">
                                <Image Source="{Binding CurrentImage}"
                                       Stretch="None"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top" />

                                <ItemsControl ItemsSource="{Binding CurrentOverlays}" IsHitTestVisible="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <Canvas Width="{Binding CurrentImage.PixelWidth}"
                                                    Height="{Binding CurrentImage.PixelHeight}" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="Canvas.Left" Value="{Binding X}" />
                                            <Setter Property="Canvas.Top" Value="{Binding Y}" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Rectangle Width="{Binding Width}"
                                                           Height="{Binding Height}"
                                                           Stroke="{Binding Stroke}"
                                                           StrokeThickness="2"
                                                           Fill="Transparent"
                                                           Opacity="{Binding Opacity}" />
                                                <Border Background="{Binding Stroke}"
                                                        Padding="3,2"
                                                        CornerRadius="3"
                                                        HorizontalAlignment="Left"
                                                        VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Label}" Foreground="White" FontSize="11" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <DockPanel Grid.Row="1" Margin="0,10,0,0">
                    <TextBlock Text="{Binding SelectedPageText}" VerticalAlignment="Center" />
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Zoom" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <Slider Width="220"
                                Minimum="0.25"
                                Maximum="4"
                                SmallChange="0.05"
                                LargeChange="0.25"
                                Value="{Binding Zoom, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </DockPanel>
            </Grid>

            <!-- Right: Action/Info -->
            <Border Grid.Column="2" Background="#F7F7F7" CornerRadius="6" Padding="12" Margin="10">
                <StackPanel>
                    <TextBlock Text="操作・情報" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedPageText}" Foreground="#666" Margin="0,2,0,10" />

                    <TextBlock Text="NGコード" FontWeight="SemiBold" />
                    <ItemsControl ItemsSource="{Binding SelectedPage.Detections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4"
                                        Padding="8"
                                        Margin="0,6,0,0"
                                        Background="{Binding LevelBrush}"
                                        Opacity="{Binding DisplayOpacity}">
                                    <TextBlock Text="{Binding DisplayText}" Foreground="White" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="判定" FontWeight="SemiBold" Margin="0,14,0,0" />
                    <TextBlock Text="{Binding SelectedDecisionText}"
                               Foreground="#333"
                               Margin="0,4,0,0"
                               TextWrapping="Wrap" />

                    <UniformGrid Columns="2" Margin="0,14,0,0">
                        <Button Content="OK (Space)" Margin="0,0,6,6" Command="{Binding MarkOkCommand}" />
                        <Button Content="再スキャン (S)" Margin="6,0,0,6" Command="{Binding MarkRescanCommand}" />
                        <Button Content="例外承認 (E)" Margin="0,6,6,0" Command="{Binding RequestExceptionCommand}" />
                        <Button Content="CSV出力" Margin="6,6,0,0" Command="{Binding ExportCsvCommand}" />
                    </UniformGrid>

                    <Separator Margin="0,14,0,10" />
                    <TextBlock Text="{Binding OutputDirectoryText}" Foreground="#666" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
