<Window x:Class="KenpinTool.Prototype.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:KenpinTool.Prototype"
        mc:Ignorable="d"
        Title="KenpinTool Prototype" Height="720" Width="1280">
    
    <Window.Resources>
        <DropShadowEffect x:Key="StatusShadow" BlurRadius="8" ShadowDepth="2" Opacity="0.6" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="J" Command="{Binding NextPageCommand}" />
        <KeyBinding Key="K" Command="{Binding PrevPageCommand}" />
    </Window.InputBindings>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <!-- Left Pane: File List -->
        <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="0,0,1,0">
            <ListView ItemsSource="{Binding PagesView}" 
                      SelectedItem="{Binding SelectedPage}"
                      SelectionMode="Single"
                      VirtualizingPanel.IsVirtualizing="True">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Index, StringFormat='{}{0:000}'}" Margin="0,0,10,0" Foreground="Gray"/>
                            <TextBlock Text="{Binding FileName}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Center Pane: Image Viewer -->
        <Grid Grid.Column="1" Background="#222" ClipToBounds="True">
            <Image Source="{Binding CurrentImage}" 
                   RenderOptions.BitmapScalingMode="NearestNeighbor" 
                   Stretch="Uniform">
                <Image.LayoutTransform>
                    <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
                </Image.LayoutTransform>
            </Image>
            
            <!-- Simple Overlay for status -->
            <TextBlock Text="{Binding SelectedDecisionText}" 
                       Foreground="Yellow" 
                       FontSize="20" 
                       HorizontalAlignment="Left" 
                       VerticalAlignment="Top" 
                       Margin="10" 
                       Effect="{StaticResource StatusShadow}"/>
        </Grid>

        <!-- Right Pane: Controls -->
        <StackPanel Grid.Column="2" Background="#EEE" Orientation="Vertical" Margin="10">
            <TextBlock Text="Case Info" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
            <TextBlock Text="{Binding CaseName}" Margin="0,0,0,10"/>

            <TextBlock Text="Folder Path:" FontWeight="Bold" />
            <TextBox Text="{Binding InputFolderPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5"/>
            <Button Content="Load" Command="{Binding LoadCommand}" Margin="0,0,0,20" Padding="5"/>

            <TextBlock Text="{Binding StatusMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,10" FontWeight="Bold"/>
            <TextBlock Text="{Binding ProgressText}" Margin="0,0,0,5"/>
            <TextBlock Text="{Binding PageCountText}" Margin="0,0,0,20"/>

            <Separator Margin="0,10" />

            <TextBlock Text="Action" FontWeight="Bold" Margin="0,0,0,5"/>
            <Button Content="OK (Mark as OK)" Command="{Binding MarkOkCommand}" Margin="0,5" Padding="10" Background="LightGreen"/>
            <Button Content="Rescan (NG-A)" Command="{Binding MarkRescanCommand}" Margin="0,5" Padding="10" Background="LightYellow"/>
            <Button Content="Exception (NG-B/C)" Command="{Binding RequestExceptionCommand}" Margin="0,5" Padding="10" Background="LightPink"/>

            <Separator Margin="0,20" />
            
            <CheckBox Content="Show NG Only" IsChecked="{Binding ShowNgOnly}" Command="{Binding ToggleFilterCommand}" Margin="0,5"/>
            <CheckBox Content="Compare Mode" IsChecked="{Binding CompareMode}" Command="{Binding ToggleCompareCommand}" Margin="0,5"/>
            <Button Content="Toggle Zoom (x1 / x2)" Command="{Binding ToggleZoomCommand}" Margin="0,5"/>
            
            <Separator Margin="0,20" />
             <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" Margin="0,5"/>
        </StackPanel>
    </Grid>
</Window>
