<Window x:Class="KenpinTool.Prototype.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:KenpinTool.Prototype"
        mc:Ignorable="d"
        Title="検品ツール プロトタイプ" Height="720" Width="1280">
    
    <Window.Resources>
        <DropShadowEffect x:Key="StatusShadow" BlurRadius="8" ShadowDepth="2" Opacity="0.6" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="J" Command="{Binding NextPageCommand}" />
        <KeyBinding Key="K" Command="{Binding PrevPageCommand}" />
        <KeyBinding Key="Z" Command="{Binding ToggleZoomCommand}" />
        <KeyBinding Key="Add" Modifiers="Control" Command="{Binding ZoomInCommand}" />
        <KeyBinding Key="OemPlus" Modifiers="Control" Command="{Binding ZoomInCommand}" />
        <KeyBinding Key="Subtract" Modifiers="Control" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Key="OemMinus" Modifiers="Control" Command="{Binding ZoomOutCommand}" />
    </Window.InputBindings>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <!-- Left Pane: File List -->
        <Border Grid.Column="0" BorderBrush="Gray" BorderThickness="0,0,1,0">
            <ListView ItemsSource="{Binding PagesView}" 
                      SelectedItem="{Binding SelectedPage}"
                      SelectionMode="Single"
                      VirtualizingPanel.IsVirtualizing="True">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Index, StringFormat='{}{0:000}'}" Margin="0,0,10,0" Foreground="Gray"/>
                            <TextBlock Text="{Binding FileName}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <!-- Center Pane: Image Viewer -->
        <Grid Grid.Column="1" Background="#222" ClipToBounds="True" SnapsToDevicePixels="True" UseLayoutRounding="True">
            <ScrollViewer x:Name="ImageScrollHost"
                          Background="#222"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          PanningMode="Both"
                          SizeChanged="ImageScrollHost_SizeChanged"
                          PreviewMouseWheel="ImageScrollHost_PreviewMouseWheel">
                <Image Source="{Binding CurrentImage}"
                       Stretch="None"
                       StretchDirection="Both"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       SnapsToDevicePixels="True"
                       UseLayoutRounding="True">
                    <Image.LayoutTransform>
                        <ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" />
                    </Image.LayoutTransform>
                </Image>
            </ScrollViewer>
            
            <!-- Simple Overlay for status -->
            <TextBlock Text="{Binding SelectedDecisionText}" 
                       Foreground="Yellow" 
                       FontSize="20" 
                       HorizontalAlignment="Left" 
                       VerticalAlignment="Top" 
                       Margin="10" 
                       Effect="{StaticResource StatusShadow}"/>
        </Grid>

        <!-- Right Pane: Controls -->
        <StackPanel Grid.Column="2" Background="#EEE" Orientation="Vertical" Margin="10">
            <TextBlock Text="案件情報" FontWeight="Bold" FontSize="14" Margin="0,0,0,5"/>
            <TextBlock Text="{Binding CaseName}" Margin="0,0,0,10"/>

            <TextBlock Text="フォルダパス:" FontWeight="Bold" />
            <TextBox Text="{Binding InputFolderPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,5"/>
            <Button Content="読み込み" Command="{Binding LoadCommand}" Margin="0,0,0,20" Padding="5"/>

            <TextBlock Text="{Binding StatusMessage}" Foreground="Red" TextWrapping="Wrap" Margin="0,0,0,10" FontWeight="Bold"/>
            <TextBlock Text="{Binding ProgressText}" Margin="0,0,0,5"/>
            <TextBlock Text="{Binding PageCountText}" Margin="0,0,0,20"/>

            <Separator Margin="0,10" />

            <TextBlock Text="判定入力" FontWeight="Bold" Margin="0,0,0,5"/>
            <Button Content="OK（問題なし）" Command="{Binding MarkOkCommand}" Margin="0,5" Padding="10" Background="LightGreen"/>
            <Button Content="再スキャン（NG-A）" Command="{Binding MarkRescanCommand}" Margin="0,5" Padding="10" Background="LightYellow"/>
            <Button Content="例外承認（NG-B/C）" Command="{Binding RequestExceptionCommand}" Margin="0,5" Padding="10" Background="LightPink"/>
            <TextBlock Text="ショートカット: J/K=上下, Z=等倍/フィット, Ctrl+ホイール/+/−=ズーム, Space=OK" FontSize="12" Foreground="Gray" Margin="0,2,0,10"/>

            <Separator Margin="0,20" />
            
            <CheckBox Content="NG/疑いのみ表示" IsChecked="{Binding ShowNgOnly}" Command="{Binding ToggleFilterCommand}" Margin="0,5"/>
            <CheckBox Content="比較モード" IsChecked="{Binding CompareMode}" Command="{Binding ToggleCompareCommand}" Margin="0,5"/>
            <Button Content="表示モード切替 (Z)" Command="{Binding ToggleZoomCommand}" Margin="0,5"/>
            
            <Separator Margin="0,20" />
            <Button Content="Export CSV" Command="{Binding ExportCsvCommand}" Margin="0,5"/>
            <Button Content="Export Report (PDF)" Command="{Binding ExportReportCommand}" Margin="0,5"/>
        </StackPanel>
    </Grid>
</Window>
