<Window x:Class="KenpinTool.Prototype.ExceptionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:KenpinTool.Prototype"
        Title="例外承認"
        SizeToContent="WidthAndHeight"
        MinWidth="520"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="例外承認理由コード（必須）" FontWeight="SemiBold" />
        <ComboBox Grid.Row="1"
                  Margin="0,6,0,12"
                  ItemsSource="{Binding ReasonCodes}"
                  SelectedItem="{Binding SelectedReasonCode}"
                  MinWidth="480" />

        <TextBlock Grid.Row="2" Text="備考（任意）" FontWeight="SemiBold" />
        <TextBox Grid.Row="3"
                 Margin="0,6,0,0"
                 Text="{Binding Note}"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 MinHeight="90"
                 VerticalScrollBarVisibility="Auto" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" IsCancel="True" MinWidth="100" Margin="0,0,8,0" />
            <Button Content="OK" IsDefault="True" MinWidth="100" Click="Ok_Click" />
        </StackPanel>
    </Grid>
</Window>
